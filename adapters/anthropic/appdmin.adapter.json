{
  "schemaVersion": 1,
  "id": "appdmin.anthropic",
  "name": "Anthropic",
  "version": "1.0.0",
  "entrypoint": "main.ts",
  "protocol": "1.0",
  "description": "Discovers Anthropic models and validates provider access.",
  "capabilities": ["catalog", "costs", "health"],
  "permissions": { "net": ["api.anthropic.com:443"] },
  "configSchema": {
    "type": "object",
    "required": ["apiKey"],
    "properties": { "apiKey": { "type": "string", "secret": true, "title": "API key" } }
  }
}
