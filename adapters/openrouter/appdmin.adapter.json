{
  "schemaVersion": 1,
  "id": "appdmin.openrouter",
  "name": "OpenRouter",
  "version": "1.1.0",
  "entrypoint": "main.ts",
  "protocol": "1.0",
  "description": "Discovers OpenRouter models and collects key usage from the provider API.",
  "capabilities": ["catalog", "costs", "health"],
  "permissions": { "net": ["openrouter.ai:443"] },
  "configSchema": {
    "type": "object",
    "required": ["apiKey"],
    "properties": { "apiKey": { "type": "string", "secret": true, "title": "API key" } }
  }
}
