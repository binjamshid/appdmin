{
  "name": "@appdmin/core",
  "version": "2.0.0",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./src/main.ts",
    "./cli": "./src/cli.ts",
    "./adapter-sdk": "./src/core/types.ts"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys --watch src/main.ts",
    "serve": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys src/cli.ts serve",
    "cli": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run --allow-sys src/cli.ts",
    "test": "deno test --allow-read",
    "check": "deno check src/cli.ts src/main.ts adapters/*/main.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "privacy": "deno run --allow-read --allow-env scripts/privacy-check.ts",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task test && deno task privacy"
  },
  "imports": {
    "hono": "npm:hono@4.13.0",
    "hono/": "npm:/hono@4.13.0/",
    "postgres": "npm:postgres@3.4.9",
    "hash-wasm": "npm:hash-wasm@4.12.0",
    "@simplewebauthn/server": "npm:@simplewebauthn/server@13.3.2"
  },
  "fmt": { "lineWidth": 100, "singleQuote": false, "exclude": [".superpowers", ".impeccable"] },
  "lint": { "rules": { "tags": ["recommended"] }, "exclude": ["src/ui/static"] }
}
